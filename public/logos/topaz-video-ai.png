<!-- Landing Page Image Selector -->
<script>
  var before = document.getElementById("tl-twenty-image-before");
  var after  = document.getElementById("tl-twenty-image-after");
  var thumbnails       = document.getElementsByClassName("tl-photo-works");
  var thumbnailsMobile = document.getElementsByClassName("tl-photo-works-mobile");
  var keys = Object.keys(thumbnails);

  function setBeforeAndAfter(el) {
    before.src    = el.querySelector(".tl-user-snaps-before").src;
    before.srcset = el.querySelector(".tl-user-snaps-before").src;
    after.src     = el.querySelector(".tl-user-snaps-after").src;
    after.srcset  = el.querySelector(".tl-user-snaps-after").src;
  }

  Array.from(thumbnailsMobile).forEach(function(el) {
    el.addEventListener("click", function() {
      var active = document.querySelector(".tl-photo-works-mobile.tl-photo-works-active");
      if (active) active.classList.remove("tl-photo-works-active");
      el.classList.add("tl-photo-works-active");
      setBeforeAndAfter(el);
    });
  });

  keys.forEach(function(key) {
    thumbnails[key].addEventListener("click", function() {
      var active = document.getElementsByClassName("tl-photo-works-active");
      if (active[0]) active[0].className = active[0].className.replace(" tl-photo-works-active", "");
      thumbnails[key].className += " tl-photo-works-active";
      setBeforeAndAfter(thumbnails[key]);
    });
  });
</script>
<!-- End Landing Page Image Selector -->

<!-- TL Countdown -->
<script>
  function tlCountdown(id) {
    var endTime = document.getElementById(id).getAttribute("end-time");
    var endMs   = new Date(endTime).getTime();

    setInterval(function() {
      var remaining = endMs - new Date().getTime();
      var days    = document.getElementById(id + "-days");
      var hours   = document.getElementById(id + "-hours");
      var minutes = document.getElementById(id + "-minutes");
      var seconds = document.getElementById(id + "-seconds");

      if (remaining <= 0) {
        days.innerHTML = hours.innerHTML = minutes.innerHTML = seconds.innerHTML = "00";
      } else {
        days.innerHTML    = Math.floor(remaining / 86400000);
        hours.innerHTML   = Math.floor((remaining % 86400000) / 3600000);
        minutes.innerHTML = Math.floor((remaining % 3600000)  / 60000);
        seconds.innerHTML = Math.floor((remaining % 60000)    / 1000);
      }
    }, 1000);
  }
  tlCountdown("tl-clock");
</script>
<!-- End TL Countdown -->

