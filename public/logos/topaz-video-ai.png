<script type="text/javascript">
  jQuery(function($) {
    $("body").imagesLoaded(function() {

      $('.twentytwenty-slider').twentytwenty({
        default_offset_pct: 0.7,
        orientation: 'horizontal',
        no_overlay: true,
        move_slider_on_hover: true,
        move_with_handle_only: true,
        click_to_move: true
      });

      $('._1-twentytwenty').twentytwenty({
        default_offset_pct: 0.5,
        orientation: 'horizontal',
        no_overlay: true,
        move_slider_on_hover: true,
        move_with_handle_only: true,
        click_to_move: true
      });

      $(window).trigger("resize.twentytwenty");
      $(window).on('resize', function() {
        $(this).trigger("resize.twentytwenty");
      });

    });
  });
</script>

<!-- Swap before/after labels in .b2-twenty containers -->
<script>
  $(window).on('load', function() {
    setTimeout(function() {
      var leftArrows  = document.querySelectorAll(".b2-twenty .twentytwenty-left-arrow");
      var rightArrows = document.querySelectorAll(".b2-twenty .twentytwenty-right-arrow");
      leftArrows.forEach(function(el)  { el.innerHTML = "After";  });
      rightArrows.forEach(function(el) { el.innerHTML = "Before"; });
    }, 1000);
  });
</script>

