<!-- ============================================================
  CONSENT-GATED TRACKING
  Amplitude + Segment → statistics consent
  Klaviyo             → marketing consent

  Three-layer approach handles all user scenarios:
    CookiebotOnLoad   — returning consented user, consent read from cookie on page load
    CookiebotOnAccept — user actively accepts, plus page loads for already-consented users
    Synchronous check — GTM race condition safety net: catches the case where Cookiebot
                        (loaded async via GTM) already fired before these listeners registered
  ============================================================ -->
<script>

  

  function initKlaviyo() {
    var s = document.createElement('script');
    s.type  = 'text/javascript';
    s.async = true;
    s.src   = 'https://static.klaviyo.com/onsite/js/WuPC5p/klaviyo.js';
    document.head.appendChild(s);

    !function(){if(!window.klaviyo){window._klOnsite=window._klOnsite||[];try{window.klaviyo=new Proxy({},{get:function(n,i){return"push"===i?function(){var n;(n=window._klOnsite).push.apply(n,arguments)}:function(){for(var n=arguments.length,o=new Array(n),w=0;w<n;w++)o[w]=arguments[w];var t="function"==typeof o[o.length-1]?o.pop():void 0,e=new Promise((function(n){window._klOnsite.push([i].concat(o,[function(i){t&&t(i),n(i)}]))}));return e}}})}catch(n){window.klaviyo=window.klaviyo||[],window.klaviyo.push=function(){var n;(n=window._klOnsite).push.apply(n,arguments)}}}}();
  }

  // Prevents double-loading when multiple consent events fire in the same session
  var _tlInitialized = { klaviyo: false };

  function handleConsent() {
    if (!window.Cookiebot || !window.Cookiebot.consent) return;

    if (Cookiebot.consent.marketing) {
      if (!_tlInitialized.klaviyo)   { initKlaviyo();   _tlInitialized.klaviyo   = true; }
    }
  }

  window.addEventListener('CookiebotOnLoad',   handleConsent, false);
  window.addEventListener('CookiebotOnAccept', handleConsent, false);

  // GTM race condition safety net — if Cookiebot already fired before
  // these listeners were registered, run the handler immediately
  if (window.Cookiebot && window.Cookiebot.consent) {
    handleConsent();
  }

</script></body></html>